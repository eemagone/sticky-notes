{
    "name":  "note",
    "productName":  "Note",
    "version":  "0.1.0",
    "description":  "Local sticky notes",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "test":  "node storage.test.js \u0026\u0026 node taskfiles.test.js \u0026\u0026 node archive.test.js",
                    "icon":  "node icon.js",
                    "pack":  "electron-builder --win dir",
                    "dist":  "electron-builder --win nsis"
                },
    "license":  "MIT",
    "devDependencies":  {
                            "electron":  "^44.5.1",
                            "electron-builder":  "^26.15.3"
                        },
    "build":  {
                  "appId":  "local.note.app",
                  "productName":  "Note",
                  "npmRebuild":  false,
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "*.js",
                                "!*.test.js",
                                "note/**",
                                "launcher/**",
                                "fonts/**",
                                "package.json"
                            ],
                  "win":  {
                              "target":  "nsis",
                              "icon":  "build/icon.png"
                          },
                  "nsis":  {
                               "oneClick":  true,
                               "perMachine":  false,
                               "shortcutName":  "Note",
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "runAfterFinish":  false
                           }
              },
    "dependencies":  {
                         "adm-zip":  "^0.6.1",
                         "koffi":  "^3.3.2"
                     }
}