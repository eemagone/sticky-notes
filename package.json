{
  "name": "sticky-notes",
  "productName": "Sticky Notes",
  "version": "1.0.0",
  "description": "Sticky notes for Windows with task lists. Fully local.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "test:e2e": "electron tests/e2e/run.js",
    "icon": "node src/main/icon.js",
    "dist": "node src/main/icon.js && electron-builder --win portable nsis --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.stickynotes.app",
    "productName": "Sticky Notes",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "assets/fonts/**",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "StickyNotes.exe",
      "splashImage": "build/splash.bmp"
    },
    "nsis": {
      "artifactName": "StickyNotes-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Sticky Notes",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "koffi": "^3.3.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "Emils"
}
